# Local development: enables demo accounts (password: gocart-demo).
# Do not use demo accounts on a shared or public environment.
DEX_DEMO_USERS=true

# Optional: set credentials for either provider to enable that sign-in method.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin account email; change this to the verified email you use with a provider.
ADMIN_EMAILS=admin@gocart.test