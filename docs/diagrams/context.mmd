flowchart LR
    cust([Customer])
    admin([Admin])
    card[[Card network<br/>mock provider]]

    subgraph order_ctx [Order bounded context]
        direction TB
        oapi[HTTP API]
        osvc[Commands: decide,<br/>append, coordinate]
        elog[(Event log<br/>file or Cassandra)]
        proj[Read model<br/>in memory, rebuilt from the log]
        oapi -->|commands| osvc
        osvc -->|append| elog
        elog -.->|replay at startup| proj
        osvc -.->|apply each new event| proj
        oapi -->|queries| proj
    end

    subgraph product_ctx [Product bounded context]
        direction TB
        papi[HTTP API]
        cat[(Catalogue and reservations<br/>catalog.json)]
        papi --> cat
    end

    subgraph payment_ctx [Payment bounded context]
        direction TB
        payapi[HTTP API]
        led[(Charge ledger<br/>ledger.json)]
        payapi --> led
    end

    subgraph cart_ctx [Cart bounded context]
        direction TB
        kapi[HTTP API]
        carts[(Carts, no prices<br/>carts.json)]
        kapi --> carts
    end

    cust -->|build a cart, check out| kapi
    kapi ==>|place order,<br/>same key on every retry| oapi
    kapi -.->|does this product exist?| papi
    cust -->|place, cancel, look up| oapi
    admin -->|ship, deliver, read the log| oapi
    admin -->|add products, restock| papi
    osvc ==>|reserve / release,<br/>retried safely| papi
    osvc ==>|charge / void,<br/>retried safely| payapi
    led -->|authorize| card
